{
  "name": "agent-config-sync",
  "version": "0.1.0",
  "description": "Sync MCP servers and agent configuration across coding agents from a single manifest.",
  "type": "module",
  "bin": {
    "agent-config-sync": "./dist/cli.js",
    "acsync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run clean && npm run build",
    "check": "npm run clean && npm run build",
    "test:smoke": "node dist/cli.js render --target claude --manifest ./test-fixtures/example-manifest.yaml"
  },
  "keywords": [
    "mcp",
    "codex",
    "claude-code",
    "cli",
    "config-sync",
    "skills",
    "agents"
  ],
  "author": "Daisuke Yamashiki",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
