{
  "name": "@yama662607/agent-config-manager",
  "version": "1.3.0",
  "description": "Native Rust CLI and TUI for managing MCP servers, skills, and plugins across AI agents.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-config-manager": "bin/acm.cjs",
    "acm": "bin/acm.cjs"
  },
  "files": [
    "bin/acm.cjs",
    "native",
    "README.md",
    "README_JA.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "check": "cargo fmt --all --check && cargo clippy --all-targets --locked -- -D warnings",
    "test": "cargo test --locked",
    "dev": "cargo run --bin acm --",
    "prepare:native": "node scripts/prepare-native.mjs",
    "prepack": "node scripts/check-package.mjs",
    "test:smoke": "node scripts/package-smoke.mjs",
    "check:public": "bash scripts/check-public-safe.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skills",
    "codex",
    "claude-code",
    "claude",
    "cli",
    "config-sync",
    "agents",
    "agent-tools",
    "skill-management",
    "developer-tools",
    "grok",
    "antigravity"
  ],
  "author": "Daisuke Yamashiki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yama662607/agent-config-manager.git"
  },
  "bugs": {
    "url": "https://github.com/yama662607/agent-config-manager/issues"
  },
  "homepage": "https://github.com/yama662607/agent-config-manager#readme"
}
